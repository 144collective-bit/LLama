# Read by Hostinger's LiteSpeed server (and any Apache-compatible host).

# Single-page app: any path that isn't a real file goes to index.html, so
# links like /token and /buy work when opened directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Built JS and CSS have a content hash in their names, so browsers can keep
# them; index.html is always re-checked so updates show up straight away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Security headers.
# - Content-Security-Policy: scripts only from this site; network calls only to
#   the PulseChain RPC and WalletConnect/Reown (wallet connect); the page can't
#   be framed by another site (clickjacking). Keep this list in step with
#   src/swap/network.ts (RPC) and src/videos.ts (video host).
# - Strict-Transport-Security: browsers always use HTTPS for llamaswap.pro.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.reown.com; img-src 'self' data: blob: https:; media-src 'self' https://d8j0ntlcm91z4.cloudfront.net; connect-src 'self' https://rpc.pulsechain.com https://*.walletconnect.org https://*.walletconnect.com wss://*.walletconnect.org wss://*.walletconnect.com https://*.web3modal.org https://*.web3modal.com https://*.reown.com wss://*.reown.com; frame-src https://verify.walletconnect.org https://verify.walletconnect.com https://secure.walletconnect.org https://secure.walletconnect.com https://secure-mobile.walletconnect.org https://secure-mobile.walletconnect.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
