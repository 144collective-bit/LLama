# Hostinger (Apache/LiteSpeed) equivalent of vercel.json.

# Single-page app: any path that isn't a real file goes to index.html, so
# links like /token and /buy work when opened directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Built JS and CSS have a content hash in their names, so browsers can keep
# them; index.html is always re-checked so updates show up straight away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
